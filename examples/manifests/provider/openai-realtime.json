{
  "kind": "provider",
  "name": "openai-realtime",
  "version": "1.0.0",
  "param_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "api_key_ref": { "type": "string" },
      "input_format": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string" },
          "rate": { "type": "integer" }
        },
        "required": ["type", "rate"]
      },
      "output_format": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string" }
        },
        "required": ["type"]
      },
      "turn_detection": { "type": "string" },
      "voice": { "type": "string" }
    },
    "required": ["api_key_ref", "input_format", "output_format", "turn_detection", "voice"]
  },
  "provider_caps": {
    "turn_taking_owners": ["server_vad", "semantic", "external"],
    "supported_codecs": ["pcm16"],
    "input_rate": 24000,
    "output_rate": 24000
  }
}
