; Minimal local-only PJSIP account for the VoxBench softphone demo.
; Replace REPLACE_WITH_LOCAL_SECRET locally and use the same value in the softphone.

[global]
type=global
user_agent=VoxBench local demo

[transport-udp]
type=transport
protocol=udp
bind=127.0.0.1:5060

[6001]
type=endpoint
transport=transport-udp
context=voxbench-demo
disallow=all
allow=ulaw
direct_media=no
force_rport=yes
rewrite_contact=yes
rtp_symmetric=yes
auth=6001-auth
aors=6001

[6001-auth]
type=auth
auth_type=userpass
username=6001
password=REPLACE_WITH_LOCAL_SECRET

[6001]
type=aor
max_contacts=1
remove_existing=yes
